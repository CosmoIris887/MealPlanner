# ============================================================================
# KONFIGURASI URL BACKEND UNTUK FRONTEND (VITE & ANDROID APK)
# ============================================================================

# 1. Mode Development Browser Lokal (Menggunakan Vite Proxy):
# Biarkan kosong atau gunakan:
# VITE_API_URL=/api

# 2. Mode Pengujian Android APK pada Jaringan Lokal (WiFi / Hotspot):
# Ganti dengan alamat IP komputer/laptop yang menjalankan backend (jangan gunakan localhost):
# VITE_API_URL=http://192.168.1.100:5000/api

# 3. Mode Android Emulator:
# Gunakan alamat loopback khusus Android Emulator jika backend di PC yang sama:
# VITE_API_URL=http://10.0.2.2:5000/api

# 4. Mode Production (Server Publik / Cloud VPS):
# VITE_API_URL=https://api.domainanda.com/api
