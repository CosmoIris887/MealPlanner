# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment files & Secrets
.env
.env.local
.env.*.local
*.env
!backend/.env.example
!frontend/.env.example

# Build outputs
dist/
frontend/dist/
build/
*.tsbuildinfo

# SQLite databases & journals (Local database stays on device)
database/*.sqlite
database/*.sqlite-journal
backend/database/*.sqlite
backend/database/*.sqlite-journal

# Uploads & Temporary Files
backend/uploads/food-*
backend/uploads/dataset/
backend/uploads/temp-zip/
backend/uploads/*.zip
backend/uploads/*.tar.gz
uploads/food-*
uploads/dataset/
uploads/temp-zip/
uploads/*.zip

# Machine Learning & Training Artifacts (Prevent heavy models from entering repo)
*.npz
*.npy
*.onnx
*.h5
*.keras
*.joblib
*.pkl
__pycache__/
*.py[cod]
*$py.class
backend/ml/__pycache__/
backend/ml/*.npz
backend/ml/*.npy
backend/ml/*.onnx
backend/ml/*.h5
backend/ml/*.keras
backend/ml/*.joblib

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Android & Capacitor build artifacts
.gradle/
android/app/build/
android/.gradle/
android/build/
*.apk
*.aab

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
